# CoastGuide AI uses any OpenAI-compatible chat completions endpoint.
# Groq (https://console.groq.com/keys) has a free tier and is fast — good for a hackathon demo.
# If AI_API_KEY is left unset, the app falls back to a rule-based planner so the demo still works offline.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
